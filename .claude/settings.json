{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(node node_modules/typescript/bin/tsc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git grep*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(git rev-parse*)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(./.secrets/**)",
      "Read(~/.claude/settings-glm-backup.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git remote -v*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
